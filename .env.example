# NVIDIA NIM / Nemotron Ultra Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-your-key-here
NEMOTRON_DEFAULT_MODEL=google/diffusiongemma-26b-a4b-it
NEMOTRON_TIMEOUT_MS=30000
NEMOTRON_MAX_RETRIES=3

# Optional: Context7 API key for MCP logging
CONTEXT7_API_KEY=ctx7sk-dummy-key

# API Server (harness/api_server) — required to run the orchestration HTTP API
API_SERVER_KEY=change-me-to-a-long-random-string

# Governance / gate tuning (all optional; defaults live in harness/shared/governance-policy.json)
# MAX_FILE_LINES=500
# LOG_LEVEL=INFO
# ALLOW_GITHUB_CHANGES=1   # set only with human attestation for protected-path changes
