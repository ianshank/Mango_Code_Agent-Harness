# NVIDIA NIM / Nemotron Ultra Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-your-key-here
NEMOTRON_DEFAULT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NEMOTRON_TIMEOUT_MS=30000
NEMOTRON_MAX_RETRIES=3

# API Server (harness/api_server) — required to run the orchestration HTTP API
API_SERVER_KEY=change-me-to-a-long-random-string
