# NVIDIA NIM / Nemotron Ultra Configuration (Local Secret)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_DEFAULT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEMOTRON_TIMEOUT_MS=60000
NEMOTRON_MAX_RETRIES=3

# Optional: Context7 API key for MCP logging
CONTEXT7_API_KEY=ctx7sk-dummy-key

# API Server (harness/api_server) — required to run the orchestration HTTP API
API_SERVER_KEY=change-me-to-a-long-random-string

# Governance / gate tuning (all optional; defaults live in harness/shared/governance-policy.json)
# MAX_FILE_LINES=500
# LOG_LEVEL=INFO
# ALLOW_GITHUB_CHANGES=1   # set only with human attestation for protected-path changes

# Evidence signing (harness/shared/governance/evidence_manifest.py, publish_policy_artifact --attest)
# A missing key fails closed at export() time; there is no fallback key.
# AGENT_EVIDENCE_KEY=change-me-to-a-long-random-string

# Shadow planner comparison channel (docs/specs/mangomas-integration-core.md).
# Observation-only and off unless MANGO_SHADOW_PLANNER is exactly "1".
# MANGO_SHADOW_PLANNER=1
# MANGO_SHADOW_MODEL=            # alternate model for the shadow pass; defaults to the orchestrator model
# MANGO_SHADOW_TIMEOUT_SEC=60    # capped at the orchestrator API timeout
# MANGO_SIGNAL_DIR=              # overrides <workspace>/.mango/memory/signals/
