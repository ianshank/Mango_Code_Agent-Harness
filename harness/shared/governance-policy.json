{
  "schema_version": "2.0.0",
  "policy_id": "agentic-ssd-governance",
  "authority_model": {
    "execution_enforcement": "external-tool-broker-and-native-pre-push",
    "repository_conformance": "ci-required-workflow",
    "rule": "CI verifies repository state and evidence; it is not described as preventing a network transfer that already occurred."
  },
  "target_contract": [
    "install",
    "format",
    "lint",
    "types",
    "test",
    "cov",
    "secrets",
    "specs",
    "audit",
    "remotes",
    "projections",
    "traceability",
    "governance",
    "guard-probe",
    "pre-pr",
    "clean"
  ],
  "pre_pr_order": [
    "install",
    "lint",
    "types",
    "cov",
    "secrets",
    "specs",
    "audit",
    "remotes",
    "projections",
    "traceability",
    "governance"
  ],
  "ci_required_targets": [
    "cov",
    "lint",
    "types",
    "secrets",
    "specs",
    "audit",
    "remotes",
    "projections",
    "traceability",
    "governance"
  ],
  "coverage": {
    "lines": 90,
    "statements": 90,
    "functions": 90,
    "branches": 80,
    "per_file": true,
    "optional_extras": {
      "langgraph": {
        "import_name": "langgraph.graph",
        "deselect_env": "MANGO_CI_DESELECT_LANGGRAPH",
        "path_prefixes": ["harness/shared/langgraph/"]
      }
    }
  },
  "limits": {
    "size_budget_lines": 500,
    "test_size_budget_lines": 700,
    "changelog_section_lines": 400
  },
  "decision_id_pattern": "^(DEC-[0-9]+|RB-[0-9]+[a-z]?|G-[A-Z]+|S[0-9]+\\.[0-9]+)$",
  "agent_defaults": {
    "max_delegation_depth": 2,
    "max_parallel_subagents": 6,
    "max_tool_calls_per_task": 100,
    "deny_unclassified_side_effects": true,
    "human_approval_required": [
      "external_write",
      "destructive",
      "secret_access",
      "permission_change",
      "production_change"
    ],
    "evidence_required_for": [
      "write",
      "network",
      "destructive",
      "secret_access",
      "permission_change"
    ]
  },
  "orchestrator": {
    "max_iterations": 10,
    "api_timeout_sec": 300,
    "tool_timeout_sec": 30,
    "max_command_bytes": 8192,
    "max_healing_retries": 3,
    "max_output_bytes": 65536
  },
  "nemotron": {
    "temperature": 0.2,
    "top_p": 0.7,
    "max_tokens": 4096,
    "timeout_ms": 30000,
    "max_retries": 0
  },
  "langgraph": {
    "recursion_limit": 50,
    "max_concurrency": 3,
    "plan_divergence_threshold": 0.35
  },
  "protected_paths": [
    ".governance/**",
    "**/.governance/**",
    ".github/workflows/**",
    "**/.github/workflows/**",
    ".github/CODEOWNERS",
    "**/.github/CODEOWNERS",
    "Makefile",
    "GNUmakefile",
    "makefile",
    "harness/*/Makefile",
    "pyproject.toml",
    "setup.py",
    "setup.cfg",
    "pytest.ini",
    "tox.ini",
    "sitecustomize.py",
    "usercustomize.py",
    "*.pth",
    "requirements.txt",
    "requirements-dev.txt",
    ".gitleaks.toml",
    "agents/**",
    "harness/*/agents/**",
    ".mango/agents/**",
    ".mango/settings.json",
    ".mango/hooks/**",
    ".mango/skills/**",
    ".claude/settings.json",
    ".claude/hooks/**",
    "CLAUDE.md",
    "docs/PROJECT-CHARTER.md",
    "harness/*/docs/PROJECT-CHARTER.md",
    "harness/CONTRACT.md",
    "harness/shared/agent-policy.json",
    "harness/shared/governance-policy.json",
    "harness/shared/check_dedup.py",
    "harness/shared/check_py_compat.py",
    "harness/shared/governance/**",
    "harness/shared/remotes.py",
    "harness/shared/pretooluse_guard.py",
    "harness/shared/pretooluse_guard.sh",
    "harness/shared/install_hooks.sh",
    "harness/shared/pre_push_scan.sh",
    "harness/shared/verify_zero_skips.py",
    "harness/shared/validate_specs.sh",
    "harness/shared/validate_specs.py",
    "harness/shared/plan_rules.py",
    "harness/shared/validate_plan.py",
    "harness/shared/validate_policy.py",
    "harness/shared/validate_agent_policy.py",
    "harness/shared/validate_governance_docs.py",
    "harness/shared/validate_adoption.py",
    "harness/shared/validate_invariants.py",
    "harness/shared/check_traceability.py",
    "harness/shared/check_projections.py",
    "harness/control-plane/publish_policy_artifact.py",
    "harness/control-plane/policy-artifact.json",
    "harness/control-plane/regenerate_bundle_digests.py",
    "harness/control-plane/tool_broker_reference.py",
    "harness/shared/write_policy.py",
    "harness/shared/read_policy.py",
    "harness/shared/tool_executors.py",
    "harness/shared/tool_dispatch.py",
    "harness/shared/tool_schemas.py",
    "harness/shared/agent_prompts.py",
    "harness/shared/nemotron_bridge.py",
    "harness/shared/orchestrator/**",
    "conftest.py",
    "**/conftest.py",
    "harness/shared/mango_mas_orchestrator.py",
    "harness/shared/agent_authority.py",
    "harness/shared/debug_dump.py",
    "harness/shared/policy_loader.py",
    "harness/shared/governance_json.py",
    ".claude/settings.local.json",
    ".mango/settings.local.json",
    "harness/shared/tests/test_protected_path_liveness.py",
    "harness/shared/tests/*ci_gate*.py",
    "harness/shared/tests/test_coverage_policy_enforcement.py",
    "harness/shared/langgraph/**"
  ],
  "external_root_of_trust_required": true,
  "charter_version": "2.0",
  "governance_skill_path": "agents/GOVERNANCE_SKILL.md",
  "skill_max_age_days": 90,
  "dedup": {
    "max_shim_lines": 40,
    "exempt": [],
    "rationale": "Per-stack scripts must delegate to harness/shared; see harness/shared/check_dedup.py"
  },
  "py_compat": {
    "skip_dirs": [],
    "rationale": "Minimum runtime is derived from the CI python-version matrix; see harness/shared/check_py_compat.py"
  },
  "synthesis": {
    "max_repair_cycles": 3,
    "lats_enabled": false,
    "lats_quality_threshold": 0.0,
    "critique_schema_version": "1.0",
    "seed_task_suite_version": "1.0",
    "prohibited_imports": [
      "os.system",
      "subprocess",
      "shutil.rmtree",
      "importlib",
      "__import__"
    ],
    "rationale": "Synthesis policy gates (INV-9..INV-15). max_repair_cycles is the budget for the repair loop (INV-12). lats_enabled must be false until ablation gate in tasks.md \u00a7Evaluation Gate is passed (INV-15). critique_schema_version pins the versioned critique schema (INV-11)."
  },
  "lats": {
    "max_budget": 10,
    "exploration_weight": 1.414
  }
}