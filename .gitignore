# Python Testing & Tooling
.coverage
# The per-worker halves of the line above. `coverage-python` runs pytest under
# `-n auto` (PYTEST_PARALLEL_FLAGS), and pytest-cov hands each xdist worker its
# own `.coverage.<host>.pid<n>.<rand>` data file in the invocation directory --
# the repository root -- before combining them into `.coverage` and deleting
# them. A run that is interrupted, killed, or ends with a crashed worker leaves
# them behind. Observed directly: watching the tree through one
# `pytest -n 2 --cov` run showed five such files appear and disappear. Ignoring
# `.coverage` and not its siblings meant the tidy half was invisible to
# `git status` and the leftovers were not.
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Wheels land in whatever directory `pip download` / `pip wheel` ran from, which
# for this repository is the root. Six appeared there during the DEC-065 work --
# mypy and its dependency closure (librt, ast_serialize, mypy_extensions,
# pathspec, typing_extensions) -- as untracked files, one `git add -A` from
# being committed. `dist/` above covers only wheels this project builds *of
# itself*, which is a different thing and was not what landed. No tracked file
# carries this extension.
*.whl
htmlcov/
.benchmarks/
scratch/

# IDE & System
.DS_Store
Thumbs.db
__pycache__/
*.pyc
*.log

.venv

# Isolated worktrees Claude Code creates for parallel agent slices; each is
# merged as a branch and removed, never committed from the primary checkout.
.claude/worktrees/

# Pytest / Hypothesis temp directories created in harness/node/ during local runs
harness/node/test-*/
.hypothesis/

# machine-readable coverage report consumed by coverage_gate.py (regenerated per run)
coverage.json

# Test execution memory and history dumps
*_history.json
*_history_pretty.json
*_loop_dump.json

# LangGraph Studio & local state caches
.langgraph/
.langgraph_api/

# Skip evidence written by the repository-root conftest.py (logic in
# harness/shared/tests/_session_hooks.py, DEC-030) for the Python zero-skip
# gate (make verify-zero-skips-python); the directory is tracked via .gitkeep
# so the ignore rule always has a live parent.
harness/shared/tests/.artifacts/*
!harness/shared/tests/.artifacts/.gitkeep

# IDE tooling (workspace-local; not build inputs)
# .mcp_storage/ — Antigravity IDE MCP server cache; regenerated per session
.mcp_storage/
# .agents/ — workspace-local agent customisations for Antigravity IDE
.agents/
# pyrightconfig.json IS committed (mirrors pytest pythonpath = ["."]);
# if you want it local-only, uncomment the line below:
# pyrightconfig.json
