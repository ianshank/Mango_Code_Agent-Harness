# Secrets & Environment
.env
.env.local
.env.*.local
*.key
*.pem

# Dependencies
node_modules/
.pnpm-store/

# Build & Coverage Artifacts
dist/
build/
coverage/
**/.governance/vitest-results.json
**/.governance/coverage/
.mango/memory/
.mango/.state/
.mango/FAILURE_MEMORY.md
.gradle/
**/.gradle/

# Python Testing & Tooling
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.benchmarks/
scratch/

# IDE & System
.DS_Store
Thumbs.db
__pycache__/
*.pyc
*.log

.venv

# Isolated worktrees Claude Code creates for parallel agent slices; each is
# merged as a branch and removed, never committed from the primary checkout.
.claude/worktrees/

# Pytest / Hypothesis temp directories created in harness/node/ during local runs
harness/node/test-*/
.hypothesis/

# machine-readable coverage report consumed by coverage_gate.py (regenerated per run)
coverage.json

# Test execution memory and history dumps
*_history.json
*_history_pretty.json
*_loop_dump.json

# LangGraph Studio & local state caches
.langgraph/
.langgraph_api/

# Skip evidence written by the repository-root conftest.py (logic in
# harness/shared/tests/_session_hooks.py, DEC-030) for the Python zero-skip
# gate (make verify-zero-skips-python); the directory is tracked via .gitkeep
# so the ignore rule always has a live parent.
harness/shared/tests/.artifacts/*
!harness/shared/tests/.artifacts/.gitkeep

# IDE tooling (workspace-local; not build inputs)
# .mcp_storage/ — Antigravity IDE MCP server cache; regenerated per session
.mcp_storage/
# .agents/ — workspace-local agent customisations for Antigravity IDE
.agents/
# pyrightconfig.json IS committed (mirrors pytest pythonpath = ["."]);
# if you want it local-only, uncomment the line below:
# pyrightconfig.json
